{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "lib": [
      "esnext"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // TypeScript 6 no longer auto-includes @types/* ambient packages; list the
    // one providing Node globals (fs, path, console, __dirname) explicitly.
    // Module-resolved typings (@types/glob, @types/yargs, …) are unaffected.
    "types": ["node"],
  }
}